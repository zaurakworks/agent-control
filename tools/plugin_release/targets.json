{
  "schema": "agent-control.plugin-release-targets",
  "version": 1,
  "source": {
    "comment": "三个运行端的 agent-plugins Marketplace 都注册为本机目录源，指向这个工作树本身；因此「源」就是它当前检出的内容，不是 origin/main。切分支会改变运行端下次安装到的东西，check 因此必须报告分支。",
    "repository": "C:/Users/Morni/workspace/agent-plugins",
    "plugins_path": "plugins",
    "declaration": "tests/workflow-routing.json",
    "declaration_key": "pluginVersions",
    "marketplace_name": "agent-plugins",
    "conformance_tests": [
      "tests/workflow-routing.test.ts",
      "plugins/orchestrated-collaboration/tests/verify-three-party-review.test.ts"
    ],
    "version_declarations": [
      "plugins/{plugin}/.claude-plugin/plugin.json",
      "plugins/{plugin}/.codex-plugin/plugin.json",
      ".claude-plugin/marketplace.json",
      ".agents/plugins/marketplace.json",
      "tests/workflow-routing.json",
      "README.md"
    ]
  },
  "runtimes": [
    {
      "id": "claude",
      "label": "Claude Code",
      "cache": { "base": "home", "path": ".claude/plugins/cache/agent-plugins" },
      "install": {
        "command": ["claude", "plugin", "install", "{plugin}@{marketplace}", "--scope", "user", "--yes"],
        "refresh": ["claude", "plugin", "marketplace", "update", "{marketplace}"]
      },
      "uninstall": ["claude", "plugin", "uninstall", "{plugin}@{marketplace}"]
    },
    {
      "id": "codex",
      "label": "Codex CLI",
      "cache": { "base": "home", "path": ".codex/plugins/cache/agent-plugins" },
      "install": { "command": ["codex", "plugin", "add", "{plugin}@{marketplace}"] },
      "uninstall": ["codex", "plugin", "remove", "{plugin}@{marketplace}"]
    },
    {
      "id": "orca-codex",
      "label": "Orca 内的 Codex",
      "cache": {
        "base": "environment",
        "variable": "APPDATA",
        "path": "orca/codex-runtime-home/home/plugins/cache/agent-plugins"
      },
      "install": {
        "command": ["codex", "plugin", "add", "{plugin}@{marketplace}"],
        "env": { "CODEX_HOME": "{cache_home}" }
      },
      "uninstall": ["codex", "plugin", "remove", "{plugin}@{marketplace}"],
      "cache_home": {
        "base": "environment",
        "variable": "APPDATA",
        "path": "orca/codex-runtime-home/home"
      }
    }
  ]
}
